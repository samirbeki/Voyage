@model Voyage.Web.ViewModels.Trips.TripDetailsViewModel

@{
    ViewData["Title"] = "Delete trip";
}

<div class="v-danger-card">
    <div class="v-danger-icon">
        <i class="bi bi-exclamation-triangle"></i>
    </div>

    <h1 class="v-page-title mt-2">Delete trip?</h1>

    <p class="v-muted mb-3">
        Are you sure you want to delete
        <strong>@Model.Title</strong>?
        This cannot be undone.
    </p>

    <div class="d-flex justify-content-center flex-wrap gap-2 mb-4">
        <span class="v-chip">
            <i class="bi bi-calendar-event"></i>
            @Model.StartDate.ToString("dd MMM yyyy")
            –
            @Model.EndDate.ToString("dd MMM yyyy")
        </span>

        <span class="v-chip">
            <i class="bi bi-wallet2"></i>
            @Model.Budget.ToString("0.00") €
        </span>
    </div>

    <form method="post"
          asp-action="Delete"
          asp-route-id="@Model.Id">

        <div class="d-flex justify-content-center gap-2">
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-trash"></i> Yes, delete
            </button>

            <a class="btn btn-outline-navy"
               asp-action="Details"
               asp-route-id="@Model.Id">
                Cancel
            </a>
        </div>
    </form>
</div>