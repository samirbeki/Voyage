@model IEnumerable<Voyage.Web.ViewModels.Trips.TripAllViewModel>

@{
    ViewData["Title"] = "My Trips";
}

<div class="v-page-header">
    <div>
        <h1 class="v-page-title">My Trips</h1>
        <p class="v-page-subtitle">All your journeys in one place.</p>
    </div>

    <a class="btn btn-accent" asp-action="Create">
        <i class="bi bi-plus-lg"></i> New trip
    </a>
</div>

@if (!Model.Any())
{
    <partial name="_EmptyState"
             model="@(new EmptyStateViewModel
             {
                 Icon = "bi-suitcase2",
                 Title = "No trips yet",
                 Message = "Plan your first journey and it will appear here.",
                 ActionText = "Plan a trip",
                 ActionController = "Trips",
                 ActionName = "Create"
             })" />
}
else
{
    var upcomingTrips = Model
        .Where(t => t.Status != Voyage.Web.Common.TripStatus.Completed)
        .ToList();

    var pastTrips = Model
        .Where(t => t.Status == Voyage.Web.Common.TripStatus.Completed)
        .OrderByDescending(t => t.StartDate)
        .ToList();

    @if (upcomingTrips.Any())
    {
        <section class="v-trips-group">
            <h2 class="v-trips-group-title">
                Upcoming trips
                <span class="v-trips-group-count">@upcomingTrips.Count()</span>
            </h2>

            <div class="row g-4">
                @foreach (var trip in upcomingTrips)
                {
                    <div class="col-sm-6 col-lg-4">
                        <partial name="_TripCard" model="trip" />
                    </div>
                }
            </div>
        </section>
    }

    @if (pastTrips.Any())
    {
        <section class="v-trips-group">
            <h2 class="v-trips-group-title">
                Past trips
                <span class="v-trips-group-count">@pastTrips.Count()</span>
            </h2>

            <div class="row g-4">
                @foreach (var trip in pastTrips)
                {
                    <div class="col-sm-6 col-lg-4">
                        <partial name="_TripCard" model="trip" />
                    </div>
                }
            </div>
        </section>
    }
}