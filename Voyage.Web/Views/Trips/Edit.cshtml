@model Voyage.Web.ViewModels.Trips.TripFormViewModel

@{
    ViewData["Title"] = "Edit trip";
}

<div class="v-form-card">
    <h1 class="v-page-title mb-1">Edit trip</h1>
    <p class="v-page-subtitle mb-4">
        Change the dates, the budget or the destinations.
    </p>

    <form method="post" asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="Title"></label>
            <input class="form-control" asp-for="Title" placeholder="e.g. Summer in Greece" />
            <span class="text-danger" asp-validation-for="Title"></span>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label" asp-for="StartDate"></label>
                <input class="form-control" asp-for="StartDate" />
                <span class="text-danger" asp-validation-for="StartDate"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label" asp-for="EndDate"></label>
                <input class="form-control" asp-for="EndDate" />
                <span class="text-danger" asp-validation-for="EndDate"></span>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label" asp-for="Budget"></label>
                <div class="input-group">
                    <input class="form-control" asp-for="Budget" />
                    <span class="input-group-text">€</span>
                </div>
                <span class="text-danger" asp-validation-for="Budget"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label" asp-for="CoverImageUrl"></label>
                <input class="form-control"
                       asp-for="CoverImageUrl"
                       placeholder="/images/destinations/santorini.jpg" />
                <span class="text-danger" asp-validation-for="CoverImageUrl"></span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="Description"></label>
            <textarea class="form-control" rows="3" asp-for="Description"></textarea>
            <span class="text-danger" asp-validation-for="Description"></span>
        </div>

        <div class="mb-4">
            <label class="form-label" asp-for="SelectedDestinationIds"></label>

            <div class="v-check-grid">
                @foreach (var destination in Model.AvailableDestinations)
                {
                    <label class="v-check-item">
                        <input type="checkbox"
                               name="SelectedDestinationIds"
                               value="@destination.Id"
                               @(Model.SelectedDestinationIds.Contains(destination.Id) ? "checked" : "") />

                        <span>
                            <span class="v-check-name">@destination.Name</span>
                            <span class="v-check-country">@destination.Country</span>
                        </span>
                    </label>
                }
            </div>

            <span class="text-danger"
                  asp-validation-for="SelectedDestinationIds"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent px-4">
                <i class="bi bi-check-lg"></i>
                Save changes
            </button>

            <a class="btn btn-outline-navy"
               asp-action="Details"
               asp-route-id="@ViewContext.RouteData.Values["id"]">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}