@{
    ViewData["Title"] = "Something went wrong";
}

<div class="v-error">
    <div class="v-error-code">500</div>

    <div class="v-error-icon v-error-icon-danger">
        <i class="bi bi-cloud-lightning-rain"></i>
    </div>

    <h1 class="v-error-title">Turbulence ahead</h1>

    <p class="v-error-text">
        Something went wrong on our side. Please try again in a moment.
    </p>

    <div class="d-flex justify-content-center">
        <a class="btn btn-accent" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i> Back to home
        </a>
    </div>
</div>
