@model Voyage.Web.ViewModels.Packing.PackingProgressViewModel

<div class="mb-4"
     data-packing-progress
     data-total="@Model.Total"
     data-packed="@Model.Packed"
     data-percent="@Model.Percent">

    <div class="d-flex justify-content-between align-items-center mb-2">
        <strong>Packing progress</strong>
        <span class="v-muted" data-progress-label>
            @Model.Packed of @Model.Total packed (@Model.Percent%)
        </span>
    </div>

    <div class="progress"
         role="progressbar"
         aria-label="Packing progress"
         aria-valuenow="@Model.Percent"
         aria-valuemin="0"
         aria-valuemax="100"
         style="height: 10px;">
        <div class="progress-bar"
             data-progress-bar
             style="width: @Model.Percent%">
        </div>
    </div>

    @if (Model.IsComplete)
    {
        <p class="text-success small mt-2 mb-0">
            <i class="bi bi-check-circle-fill"></i>
            Everything is packed!
        </p>
    }
</div>