@model Voyage.Web.ViewModels.Packing.PackingProgressViewModel

<div class="v-panel packing-progress mb-4"
     data-packing-progress
     data-total="@Model.Total"
     data-packed="@Model.Packed"
     data-percent="@Model.Percent">

    <div class="d-flex justify-content-between align-items-center mb-2">
        <strong>Packing progress</strong>

        <span class="v-muted" aria-live="polite">
            <span data-progress-text>
                @Model.Packed of @Model.Total packed
            </span>

            (<span data-progress-percent>@Model.Percent</span>%)
        </span>
    </div>

    <div class="progress packing-progress-bar"
         role="progressbar"
         aria-label="Packing progress"
         aria-valuenow="@Model.Percent"
         aria-valuemin="0"
         aria-valuemax="100">

        <div class="progress-bar @(Model.IsComplete ? "bg-success" : string.Empty)"
             data-progress-bar
             style="width: @Model.Percent%">
        </div>
    </div>

    <p class="text-success small mt-2 mb-0"
       data-progress-complete
       hidden="@(!Model.IsComplete)">
        <i class="bi bi-check-circle-fill"></i>
        Everything is packed!
    </p>
</div>