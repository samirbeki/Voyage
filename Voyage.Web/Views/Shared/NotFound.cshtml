@{
    ViewData["Title"] = "Page not found";
}

<div class="v-error">
    <div class="v-error-code">404</div>

    <div class="v-error-icon">
        <i class="bi bi-signpost-split"></i>
    </div>

    <h1 class="v-error-title">Looks like you took a wrong turn</h1>

    <p class="v-error-text">
        The page you are looking for doesn't exist or has been removed.
    </p>

    <div class="d-flex justify-content-center flex-wrap gap-2">
        <a class="btn btn-accent" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i> Back to home
        </a>
        <a class="btn btn-outline-navy" asp-controller="Destinations" asp-action="Index">
            <i class="bi bi-compass"></i> Explore destinations
        </a>
    </div>
</div>
