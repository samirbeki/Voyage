@model Voyage.Web.ViewModels.Shared.EmptyStateViewModel

<div class="v-empty">
    <i class="bi @Model.Icon"></i>

    <h3>@Model.Title</h3>

    <p class="v-muted">@Model.Message</p>

    @if (Model.ActionText != null)
    {
        <a class="btn btn-accent mt-2"
           asp-controller="@Model.ActionController"
           asp-action="@Model.ActionName">
            @Model.ActionText
        </a>
    }
</div>