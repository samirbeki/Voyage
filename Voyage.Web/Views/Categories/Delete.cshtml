@model Voyage.Web.ViewModels.Categories.CategoryAllViewModel

@{
    ViewData["Title"] = "Delete category";
}

<div class="v-page-header">
    <div>
        <h1 class="v-page-title">Delete category?</h1>
        <p class="v-page-subtitle">This action cannot be undone.</p>
    </div>
</div>

<div class="v-danger-card">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="v-danger-icon">
        <i class="bi bi-exclamation-triangle"></i>
    </div>

    <h3>Are you sure you want to delete this category?</h3>

    <p class="v-muted">
        You are about to delete
        <strong>@Model.Name</strong>.
    </p>

    <div class="mb-4">
        <span class="v-chip">
            @Model.DestinationsCount destinations
        </span>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <div class="d-flex justify-content-center gap-2">
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash"></i> Delete category
            </button>

            <a asp-action="Index" class="btn btn-outline-navy">
                Cancel
            </a>
        </div>
    </form>
</div>