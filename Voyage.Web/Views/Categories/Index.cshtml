@model IEnumerable<Voyage.Web.ViewModels.Categories.CategoryAllViewModel>

@{
    ViewData["Title"] = "Categories";
}

<div class="v-page-header">
    <div>
        <h1 class="v-page-title">Categories</h1>
        <p class="v-page-subtitle">Browse destinations by type of trip.</p>
    </div>

    <a class="btn btn-accent" asp-action="Add">
        <i class="bi bi-plus-lg"></i> Add category
    </a>
</div>

<div class="row g-4">
    @foreach (var category in Model)
    {
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <div class="v-category-card">
                <div class="v-category-icon">
                    <i class="bi bi-compass"></i>
                </div>

                <h3 class="v-category-name">@category.Name</h3>

                <p class="v-category-desc">
                    @(string.IsNullOrWhiteSpace(category.Description)
                        ? "No description yet."
                        : category.Description)
                </p>

                <div class="v-category-footer">
                    <span class="v-category-count">
                        <i class="bi bi-geo-alt"></i>
                        @category.DestinationsCount destinations
                    </span>

                    <div class="d-flex gap-1">
                        <a class="v-icon-btn"
                           title="Edit"
                           asp-action="Edit"
                           asp-route-id="@category.Id">
                            <i class="bi bi-pencil"></i>
                        </a>

                        <a class="v-icon-btn v-icon-btn-danger"
                           title="Delete"
                           asp-action="Delete"
                           asp-route-id="@category.Id">
                            <i class="bi bi-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
