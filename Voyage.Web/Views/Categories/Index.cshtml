@model IEnumerable<Voyage.Web.ViewModels.Categories.CategoryAllViewModel>

@{
    ViewData["Title"] = "Categories";
}

<div class="v-page-header">
    <div>
        <h1 class="v-page-title">Categories</h1>
        <p class="v-page-subtitle">Browse destinations by type of trip.</p>
    </div>

    <a class="btn btn-accent" asp-action="Add">
        <i class="bi bi-plus-lg"></i> Add category
    </a>
</div>

<div class="v-panel">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Destinations</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>
                            <strong>@category.Name</strong>
                        </td>
                        <td>
                            <span class="v-muted">
                                @(string.IsNullOrWhiteSpace(category.Description)
                                    ? "—"
                                    : category.Description)
                            </span>
                        </td>
                        <td>
                            <span class="v-chip">
                                @category.DestinationsCount
                            </span>
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-navy"
                               asp-action="Edit"
                               asp-route-id="@category.Id">
                                <i class="bi bi-pencil"></i> Edit
                            </a>

                            <a class="btn btn-sm btn-outline-danger"
                               asp-action="Delete"
                               asp-route-id="@category.Id">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>