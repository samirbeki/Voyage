@model Voyage.Web.ViewModels.Categories.CategoryFormViewModel

@{
    ViewData["Title"] = "Add category";
}

<div class="v-page-header">
    <div>
        <h1 class="v-page-title">Add category</h1>
        <p class="v-page-subtitle">Create a new destination category.</p>
    </div>
</div>

<div class="v-form-card">
    <form asp-action="Add" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="Category name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      placeholder="Describe this category"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-accent">
                <i class="bi bi-plus-lg"></i> Add category
            </button>

            <a asp-action="Index" class="btn btn-outline-navy">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}