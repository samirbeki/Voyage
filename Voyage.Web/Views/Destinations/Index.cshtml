
@model Voyage.Web.ViewModels.Destinations.DestinationsIndexViewModel

@{
    ViewData["Title"] = "Destinations";
}

<div class="v-page-header">
    <div>
        <h1 class="v-page-title">Destinations</h1>
        <p class="v-page-subtitle">Discover places for your next journey.</p>
    </div>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-accent" asp-action="Add">
            <i class="bi bi-plus-lg"></i> Add destination
        </a>
    }
</div>

<form method="get" asp-action="Index" class="v-filter-bar mb-4">
    <div class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="searchTerm" value="@Model.SearchTerm"
                   class="form-control" placeholder="Search by name or country..." />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select">
                <option value="">All categories</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.Id" selected="@(Model.CategoryId == category.Id)">
                        @category.Name
                    </option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-accent flex-fill">
                <i class="bi bi-search"></i> Search
            </button>
            <a asp-action="Index" class="btn btn-outline-navy">Clear</a>
        </div>
    </div>
</form>

<p class="v-muted mb-3">
    @Model.TotalCount @(Model.TotalCount == 1 ? "destination" : "destinations") found
</p>

@if (!Model.Destinations.Any())
{
    <partial name="_EmptyState" model='new Voyage.Web.ViewModels.Shared.EmptyStateViewModel
    {
        Icon = "bi-search",
        Title = "No destinations found",
        Message = "Try a different search or category."
    }' />
}
else
{
    <div class="row g-4">
        @foreach (var destination in Model.Destinations)
        {
            <div class="col-sm-6 col-lg-4">
                <partial name="_DestinationCard" model="destination" />
            </div>
        }
    </div>
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-5">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-currentPage="@(Model.CurrentPage - 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-currentPage="@i"
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-categoryId="@Model.CategoryId">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-currentPage="@(Model.CurrentPage + 1)"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId">
                    Next
                </a>
            </li>
        </ul>
    </nav>
}