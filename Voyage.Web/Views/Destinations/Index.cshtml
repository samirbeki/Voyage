@model IEnumerable<Voyage.Web.ViewModels.Destinations.DestinationAllViewModel>

@{
    ViewData["Title"] = "Destinations";
}

<div class="v-page-header">
    <div>
        <h1 class="v-page-title">Destinations</h1>
        <p class="v-page-subtitle">Discover places for your next journey.</p>
    </div>

    <a class="btn btn-accent" asp-action="Add">
        <i class="bi bi-plus-lg"></i> Add destination
    </a>
</div>

<div class="row g-4">
    @foreach (var destination in Model)
    {
        <div class="col-sm-6 col-lg-4">
            <div class="v-card position-relative">
                <div class="v-card-img">
                    <img src="@destination.ImageUrl"
                         alt="@destination.Name"
                         onerror="this.style.display='none'" />

                    <span class="v-card-badge v-badge">
                        <i class="bi bi-tag"></i>
                        @destination.CategoryName
                    </span>
                </div>

                <div class="v-card-body">
                    <h3 class="v-card-title">@destination.Name</h3>

                    <div class="v-card-meta">
                        <i class="bi bi-geo-alt"></i>
                        @destination.Country
                    </div>

                    <p class="v-card-text">@destination.Description</p>

                    <div class="v-card-footer">
                        <a class="v-card-link stretched-link"
                        asp-action="Details"
                        asp-route-id="@destination.Id">
                        View details
                        <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
