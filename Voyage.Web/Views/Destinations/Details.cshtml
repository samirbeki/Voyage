@model Voyage.Web.ViewModels.Destinations.DestinationDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="v-cover">
    <img src="@Model.ImageUrl"
         alt="@Model.Name"
         onerror="this.style.display='none'" />

    <div class="v-cover-overlay">
        <div>
            <span class="v-badge">
                <i class="bi bi-tag"></i>
                @Model.CategoryName
            </span>
        </div>

        <h1>@Model.Name</h1>

        <div>
            <i class="bi bi-geo-alt"></i>
            @Model.Country
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="v-panel">
            <h2 class="v-panel-title">About this destination</h2>
            <p class="mb-0">@Model.Description</p>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="v-panel">
            <h2 class="v-panel-title">Actions</h2>

            <div class="v-actions">
                <a class="btn btn-accent"
                   asp-controller="Trips"
                   asp-action="Create"
                   asp-route-destinationId="@Model.Id">
                    <i class="bi bi-suitcase2"></i> Plan a trip here
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-navy"
                       asp-action="Edit"
                       asp-route-id="@Model.Id">
                        <i class="bi bi-pencil"></i> Edit
                    </a>

                    <a class="btn btn-outline-danger"
                       asp-action="Delete"
                       asp-route-id="@Model.Id">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                }

                <a class="btn btn-outline-navy"
                   asp-action="Index">
                    <i class="bi bi-arrow-left"></i>
                    Back to destinations
                </a>
            </div>
        </div>
    </div>
</div>

@if (Model.SimilarDestinations.Any())
{
    <section class="v-section">
        <div class="v-section-head d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <h2 class="v-section-title">More in @Model.CategoryName</h2>
                <p class="v-muted mb-0">Other places you might like.</p>
            </div>

            <a class="btn btn-outline-navy"
               asp-action="Index"
               asp-route-categoryId="@Model.CategoryId">
                View all
            </a>
        </div>

        <div class="row g-4">
            @foreach (var destination in Model.SimilarDestinations)
            {
                <div class="col-md-4">
                    <partial name="_DestinationCard" model="destination" />
                </div>
            }
        </div>
    </section>
}