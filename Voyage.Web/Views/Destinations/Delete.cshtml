@model Voyage.Web.ViewModels.Destinations.DestinationDetailsViewModel

@{
    ViewData["Title"] = "Delete destination";
}

<div class="v-danger-card">
    <div class="v-danger-icon">
        <i class="bi bi-exclamation-triangle"></i>
    </div>

    <h1 class="v-page-title mt-2">Delete destination?</h1>

    <p class="v-muted mb-4">
        Are you sure you want to delete
        <strong>@Model.Name</strong>, @Model.Country?
        It will no longer appear in the list of destinations.
    </p>

    <form method="post"
          asp-action="Delete"
          asp-route-id="@Model.Id">

        <div class="d-flex justify-content-center gap-2">
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-trash"></i> Yes, delete
            </button>

            <a class="btn btn-outline-navy"
               asp-action="Details"
               asp-route-id="@Model.Id">
                Cancel
            </a>
        </div>
    </form>
</div>