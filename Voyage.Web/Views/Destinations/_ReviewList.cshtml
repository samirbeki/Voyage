@model IEnumerable<ReviewViewModel>
@if (!Model.Any())
{
    <partial name="_EmptyState" model="@(new EmptyStateViewModel
    {
        Icon = "bi-chat-square-text",
        Title = "No reviews yet",
        Message = "Be the first to share your experience!"
    })" />
}
else
{
    <ul class="review-list">
        @foreach (var review in Model)
        {
            <li class="review-item @(review.IsHidden ? "review-hidden" : "")">
                <div class="review-header">
                    <span class="review-author">@review.AuthorName</span>
                    <span class="review-rating" title="@review.Rating / 5">
                        <partial name="_RatingStars" model="(double)review.Rating" />
                    </span>
                    <span class="review-date">
                        @review.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")
                        @if (review.IsEdited)
                        {
                            <em>(edited)</em>
                        }
                    </span>
                    @if (review.IsHidden)
                    {
                        <span class="review-hidden-badge"><i class="bi bi-eye-slash"></i> Hidden by a moderator</span>
                    }
                </div>
                <p class="review-comment">@review.Comment</p>
                @if (review.IsMine)
                {
                    <div class="review-actions">
                        <a asp-controller="Reviews"
                           asp-action="Edit"
                           asp-route-id="@review.Id"
                           class="btn btn-sm btn-outline-navy"><i class="bi bi-pencil"></i> Edit</a>
                        <a asp-controller="Reviews"
                           asp-action="Delete"
                           asp-route-id="@review.Id"
                           class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
                    </div>
                }
            </li>
        }
    </ul>
}