@model FavoritesPageViewModel

@{
    ViewData["Title"] = "My Favorites";
}

<div class="v-page-header">
    <div>
        <h1 class="v-page-title">My Favorites</h1>
        <p class="v-page-subtitle">
            Your saved destinations, all in one place.
        </p>
        <p class="v-muted mb-0">
            @Model.TotalSaved of @Model.MaxFavorites destinations saved
        </p>
    </div>
</div>

@if (Model.TotalSaved == 0)
{
    <partial name="_EmptyState" model='new EmptyStateViewModel
             {
                 Icon = "bi-heart",
                 Title = "No favorite destinations yet",
                 Message = "Save destinations you love and they will appear here."
             }' />

<div class="text-center mt-3">
        <a asp-controller="Destinations"
           asp-action="Index"
           class="btn btn-accent">
            Discover destinations
        </a>
    </div>
}
else
{
    <form method="get" asp-action="Index" class="v-filter-bar mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <input asp-for="Search"
                       class="form-control"
                       placeholder="Search by name or country..."
                       maxlength="@ValidationConstants.SearchMaxLength" />
            </div>

            <div class="col-md-3">
                <select asp-for="Sorting"
                        asp-items="Html.GetEnumSelectList<FavoritesSorting>()"
                        class="form-select">
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-accent flex-fill">
                    <i class="bi bi-search"></i> Search
                </button>

                <a asp-action="Index" class="btn btn-outline-navy">
                    Clear
                </a>
            </div>
        </div>
    </form>

    <p class="v-muted mb-3">
        @Model.ResultsCount
        @(Model.ResultsCount == 1 ? "destination found" : "destinations found")

        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <span>for "@Model.Search"</span>
        }
    </p>

    @if (!Model.Destinations.Any())
    {
        <partial name="_EmptyState" model='new EmptyStateViewModel
                 {
                     Icon = "bi-search",
                     Title = "No favorite destinations found",
                     Message = "Try a different search term."
                 }' />
    }
    else
    {
        <div class="row g-4">
            @foreach (var destination in Model.Destinations)
            {
                <div class="col-sm-6 col-lg-4">
                    <partial name="_DestinationCard" model="destination" />
                </div>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-search="@Model.Search"
                       asp-route-sorting="@Model.Sorting">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-search="@Model.Search"
                           asp-route-sorting="@Model.Sorting">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-search="@Model.Search"
                       asp-route-sorting="@Model.Sorting">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    }
}