@model IEnumerable<Voyage.Web.ViewModels.Categories.CategoryAllViewModel>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="v-page-header">
    <div>
        <h1 class="v-page-title">Manage Categories</h1>
        <p class="v-page-subtitle">Manage destination categories.</p>
    </div>

    <a class="btn btn-accent"
       asp-area="Admin"
       asp-controller="Categories"
       asp-action="Add">
        <i class="bi bi-plus-lg"></i> Add category
    </a>
</div>

<div class="v-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th class="text-center">Destinations</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@category.Name</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(category.Description)
                                    ? "No description yet."
                                    : category.Description)
                            </td>
                            <td class="text-center">@category.DestinationsCount</td>
                            <td>
                                <div class="d-flex justify-content-end gap-2">
                                    <a class="btn btn-outline-navy btn-sm"
                                       asp-area="Admin"
                                       asp-controller="Categories"
                                       asp-action="Edit"
                                       asp-route-id="@category.Id">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>

                                    <a class="btn btn-outline-danger btn-sm"
                                       asp-area="Admin"
                                       asp-controller="Categories"
                                       asp-action="Delete"
                                       asp-route-id="@category.Id">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-0">No categories have been added yet.</p>
    }
</div>