@page
@{
    ViewData["Title"] = "Access denied";
}

<div class="v-error">
    <div class="v-error-code">403</div>

    <div class="v-error-icon v-error-icon-danger">
        <i class="bi bi-shield-lock"></i>
    </div>

    <h1 class="v-error-title">Access denied</h1>

    <p class="v-error-text">
        You don't have permission to open this page.
        If you think this is a mistake, sign in with a different account.
    </p>

    <div class="d-flex justify-content-center flex-wrap gap-2">
        <a class="btn btn-accent" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-house"></i> Back to home
        </a>
        <a class="btn btn-outline-navy" asp-area="" asp-controller="Destinations" asp-action="Index">
            <i class="bi bi-compass"></i> Explore destinations
        </a>
    </div>
</div>
