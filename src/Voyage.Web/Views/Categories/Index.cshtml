@model IEnumerable<Voyage.Web.ViewModels.Categories.CategoryAllViewModel>

@{
    ViewData["Title"] = "Categories";
}

<div class="v-page-header">
    <div>
        <h1 class="v-page-title">Categories</h1>
        <p class="v-page-subtitle">Browse destinations by type of trip.</p>
    </div>

    @if (User.IsInRole(RoleConstants.Administrator))
    {
        <a class="btn btn-accent"
           asp-area="Admin"
           asp-controller="Categories"
           asp-action="Add">
            <i class="bi bi-plus-lg"></i> Add category
        </a>
    }
</div>

<div class="row g-4">
    @foreach (var category in Model)
    {
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <div class="v-category-card">
                <div class="v-category-icon">
                    <i class="bi bi-compass"></i>
                </div>

                <h3 class="v-category-name">@category.Name</h3>

                <p class="v-category-desc">
                    @(string.IsNullOrWhiteSpace(category.Description)
                        ? "No description yet."
                        : category.Description)
                </p>

                <div class="v-category-footer">
                    <a class="v-category-count"
                       asp-area=""
                       asp-controller="Destinations"
                       asp-action="Index"
                       asp-route-categoryId="@category.Id">
                        <i class="bi bi-geo-alt"></i>
                        @category.DestinationsCount @(category.DestinationsCount == 1 ? "destination" : "destinations")
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    @if (User.IsInRole(RoleConstants.Administrator))
                    {
                        <div class="d-flex gap-1">
                            <a class="v-icon-btn"
                               title="Edit"
                               asp-area="Admin"
                               asp-controller="Categories"
                               asp-action="Edit"
                               asp-route-id="@category.Id">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <a class="v-icon-btn v-icon-btn-danger"
                               title="Delete"
                               asp-area="Admin"
                               asp-controller="Categories"
                               asp-action="Delete"
                               asp-route-id="@category.Id">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>