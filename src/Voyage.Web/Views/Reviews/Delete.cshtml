@model ReviewEditViewModel

@{
    ViewData["Title"] = "Delete review";
}

<div class="v-danger-card">
    <div class="v-danger-icon">
        <i class="bi bi-exclamation-triangle"></i>
    </div>

    <h1 class="v-page-title mt-2">Delete review?</h1>

    <p class="v-muted mb-3">
        Are you sure you want to delete your review for
        <strong>@Model.DestinationName</strong>?
        This cannot be undone.
    </p>

    <div class="mb-4">
        <div class="review-rating mb-2">
            @(new string('★', Model.Rating ?? 0))@(new string('☆', ReviewValidationConstants.RatingMax - (Model.Rating ?? 0)))
        </div>
        <p class="review-comment">@Model.Comment</p>
    </div>

    <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
        <div class="d-flex justify-content-center gap-2">
            <button type="submit" class="btn btn-danger px-4">
                <i class="bi bi-trash"></i> Yes, delete
            </button>

            <a class="btn btn-outline-navy"
               asp-controller="Destinations"
               asp-action="Details"
               asp-route-id="@Model.DestinationId"
               asp-fragment="reviews">
                Cancel
            </a>
        </div>
    </form>
</div>