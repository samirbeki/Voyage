@model Voyage.Web.ViewModels.Trips.TripDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="v-cover">
    <span class="v-status v-status-@Model.Status.ToString().ToLower()">@Model.Status</span>

    <img src="@Model.CoverImageUrl"
         alt="@Model.Title"
         onerror="this.style.display='none'" />

    <div class="v-cover-overlay">
        <h1>@Model.Title</h1>

        <div>
            <i class="bi bi-calendar-event"></i>
            @Model.StartDate.ToString("dd MMM yyyy")
            –
            @Model.EndDate.ToString("dd MMM yyyy")
        </div>

        <span class="v-badge">
            <i class="bi bi-clock"></i>
            @Model.DaysCount days
        </span>
    </div>
</div>

<div class="row g-4 mt-2">
    <div class="col-lg-8">
        <div class="v-panel mb-4">
            <h2 class="v-panel-title">About this trip</h2>

            @if (string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="v-muted">No description yet.</p>
            }
            else
            {
                <p>@Model.Description</p>
            }
        </div>

        <div class="v-panel">
            <h2 class="v-panel-title">Destinations</h2>

            @if (!Model.Destinations.Any())
            {
                <p class="v-muted">No destinations available.</p>
            }
            else
            {
                <ul class="v-timeline">
                    @foreach (var destination in Model.Destinations)
                    {
                        <li class="v-timeline-item">
                            <div class="v-timeline-title">
                                @destination.Name
                            </div>

                            <div class="v-timeline-date">
                                @destination.Country
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>

        @if (Model.Status != TripStatus.Completed && Model.Destinations.Any())
        {
            <div class="mt-4"
                 data-weather-target="trip"
                 data-weather-url="@Url.Action("Weather", new { id = Model.Id })">
                <div class="v-panel">
                    <p class="v-muted mb-0">
                        <i class="bi bi-cloud-sun"></i> Loading the weather for your trip...
                    </p>
                </div>
            </div>
        }

        <div class="v-panel mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="v-panel-title mb-0">Expenses</h2>
                <a class="btn btn-accent btn-sm"
                   asp-controller="Expenses"
                   asp-action="Add"
                   asp-route-tripId="@Model.Id">
                    <i class="bi bi-plus-lg"></i> Add expense
                </a>
            </div>

            @if (!Model.Expenses.Any())
            {
                <p class="v-muted mb-0">No expenses yet. Add your first one to track the budget.</p>
            }
            else
            {
                <partial name="_ExpenseChart"
                         model="@(new ExpenseChartViewModel
                         {
                             Categories = Model.ExpensesByCategory,
                             Total = Model.TotalSpent
                         })" />

                <ul class="v-expense-list">
                    @foreach (var expense in Model.Expenses)
                    {
                        <li class="v-expense-item">
                            <div class="v-expense-main">
                                <span class="v-expense-title">@expense.Title</span>
                                <span class="v-expense-meta">
                                    @expense.Date.ToString("dd MMM yyyy") · @expense.Category
                                </span>
                            </div>

                            <div class="v-expense-side">
                                <strong>@expense.Amount.ToString("0.00") €</strong>
                                <a class="v-icon-btn"
                                   title="Edit"
                                   asp-controller="Expenses"
                                   asp-action="Edit"
                                   asp-route-id="@expense.Id">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a class="v-icon-btn v-icon-btn-danger"
                                   title="Delete"
                                   asp-controller="Expenses"
                                   asp-action="Delete"
                                   asp-route-id="@expense.Id">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="v-countdown v-countdown-@Model.Status.ToString().ToLower()">
            @if (Model.Status == TripStatus.Upcoming)
            {
                <i class="bi bi-hourglass-split v-countdown-icon"></i>
                <span class="v-countdown-number">@Model.DaysUntilStart</span>
                <span class="v-countdown-label">@(Model.DaysUntilStart == 1 ? "day to go" : "days to go")</span>
            }
            else if (Model.Status == TripStatus.Ongoing)
            {
                <i class="bi bi-geo-alt-fill v-countdown-icon"></i>
                <span class="v-countdown-number">@Model.CurrentDay</span>
                <span class="v-countdown-label">of @Model.DaysCount days</span>
            }
            else
            {
                <i class="bi bi-check2-circle v-countdown-icon"></i>
                <span class="v-countdown-number">@Model.DaysSinceEnd</span>
                <span class="v-countdown-label">@(Model.DaysSinceEnd == 1 ? "day ago" : "days ago")</span>
            }
        </div>

        <div class="v-panel mb-4">
            <h2 class="v-panel-title">Budget</h2>

            <div class="d-flex justify-content-between mb-2">
                <span class="v-muted">Total</span>
                <strong>@Model.Budget.ToString("0.00") €</strong>
            </div>

            <div class="d-flex justify-content-between mb-2">
                <span class="v-muted">Spent</span>
                <strong>@Model.TotalSpent.ToString("0.00") €</strong>
            </div>

            <div class="d-flex justify-content-between mb-3">
                <span class="v-muted">Remaining</span>
                <strong class="@(Model.RemainingBudget < 0 ? "text-danger" : "")">
                    @Model.RemainingBudget.ToString("0.00") €
                </strong>
            </div>

            @{
                bool budgetWarning = Model.RemainingBudget >= 0
                    && Model.SpentPercent >= TripValidationConstants.BudgetWarningPercent;
            }
            <div class="v-budget-bar mb-2">
                <div class="v-budget-bar-fill @(Model.RemainingBudget < 0 ? "v-budget-bar-over" : budgetWarning ? "v-budget-bar-warning" : "")"
                     style="width: @Model.SpentPercent%"></div>
            </div>
            @if (Model.RemainingBudget < 0)
            {
                <div class="v-budget-bar-label text-danger">
                    <i class="bi bi-exclamation-circle"></i>
                    Over budget by @((-Model.RemainingBudget).ToString("0.00")) €
                </div>
            }
            else if (budgetWarning)
            {
                <div class="v-budget-bar-label v-budget-warning-text">
                    <i class="bi bi-exclamation-triangle"></i>
                    @Model.SpentPercent% of the budget used. Almost at the limit.
                </div>
            }
            else
            {
                <div class="v-budget-bar-label">@Model.SpentPercent% of the budget used</div>
            }

            <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                <span class="v-muted">Per day</span>
                <strong>@Model.BudgetPerDay.ToString("0.00") €</strong>
            </div>
        </div>

        <div class="v-panel mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="v-panel-title mb-0">Packing Progress</h2>
                <span class="v-badge v-badge-teal">
                    @Model.PackingProgress.Percent%
                </span>
            </div>

            @if (Model.Status == TripStatus.Upcoming
                && Model.DaysUntilStart <= PackingItemValidationConstants.ReminderDaysBeforeStart
                && !Model.PackingProgress.IsComplete)
            {
                <div class="v-packing-due mb-3">
                    <i class="bi bi-alarm"></i>
                    Departure in @Model.DaysUntilStart @(Model.DaysUntilStart == 1 ? "day" : "days"). Time to pack!
                </div>
            }

            <div class="d-flex justify-content-between mb-2">
                <span class="v-muted">Packed items</span>
                <strong>
                    @Model.PackingProgress.Packed / @Model.PackingProgress.Total
                </strong>
            </div>

            <div class="v-budget-bar mb-2">
                <div class="v-budget-bar-fill"
                     style="width: @Model.PackingProgress.Percent%"></div>
            </div>

            @if (Model.PackingProgress.Total == 0)
            {
                <p class="v-muted mb-0">
                    Your packing list is empty. Add items to start tracking your progress.
                </p>
            }
            else if (Model.PackingProgress.IsComplete)
            {
                <p class="text-success mb-0">
                    <i class="bi bi-check-circle-fill"></i>
                    Everything is packed. You're ready to go!
                </p>
            }
            else
            {
                <p class="v-muted mb-0">
                    @(
                        Model.PackingProgress.Total - Model.PackingProgress.Packed
                    ) item(s) left to pack.
                </p>
            }

            <a class="btn btn-outline-navy btn-sm w-100 mt-3"
               asp-controller="Packing"
               asp-action="Index"
               asp-route-tripId="@Model.Id">
                <i class="bi bi-suitcase"></i>
                Open Packing List
            </a>
        </div>

        <div id="share" class="v-panel mb-4">
            <h2 class="v-panel-title">Share this trip</h2>

            @if (Model.ShareToken == null)
            {
                <p class="v-muted">
                    Create a read-only link for friends and family. They will see the dates,
                    destinations and travel costs, but cannot change anything.
                </p>

                <form method="post" asp-action="Share" asp-route-id="@Model.Id">
                    <button type="submit" class="btn btn-outline-navy btn-sm w-100">
                        <i class="bi bi-link-45deg"></i> Create share link
                    </button>
                </form>
            }
            else
            {
                string shareUrl = Url.Action(
                    "Index",
                    "SharedTrips",
                    new { token = Model.ShareToken },
                    Context.Request.Scheme)!;

                <p class="v-muted small mb-2">Anyone with this link can view the trip.</p>

                <div class="input-group input-group-sm mb-2">
                    <input type="text"
                           id="share-link"
                           class="form-control"
                           value="@shareUrl"
                           readonly
                           aria-label="Share link" />
                    <button type="button" class="btn btn-navy" data-copy-target="#share-link">
                        <i class="bi bi-clipboard"></i> Copy
                    </button>
                </div>

                <a class="small" href="@shareUrl" target="_blank" rel="noopener">
                    <i class="bi bi-box-arrow-up-right"></i> Open the shared page
                </a>

                <div class="d-flex gap-2 mt-3">
                    <form method="post" asp-action="RegenerateShareLink" asp-route-id="@Model.Id" class="flex-fill">
                        <button type="submit" class="btn btn-outline-navy btn-sm w-100">
                            <i class="bi bi-arrow-repeat"></i> New link
                        </button>
                    </form>
                    <form method="post" asp-action="StopSharing" asp-route-id="@Model.Id" class="flex-fill">
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                            <i class="bi bi-x-circle"></i> Stop sharing
                        </button>
                    </form>
                </div>
            }
        </div>

        <div class="v-panel">
            <h2 class="v-panel-title">Actions</h2>

            <div class="v-actions">
                <a class="btn btn-accent"
                   asp-controller="Packing"
                   asp-action="Index"
                   asp-route-tripId="@Model.Id">
                    <i class="bi bi-suitcase"></i>
                    Packing List
                </a>

                <a class="btn btn-navy"
                   asp-action="Edit"
                   asp-route-id="@Model.Id">
                    <i class="bi bi-pencil"></i>
                    Edit
                </a>

                <a class="btn btn-outline-danger"
                   asp-action="Delete"
                   asp-route-id="@Model.Id">
                    <i class="bi bi-trash"></i>
                    Delete
                </a>

                <a class="btn btn-outline-navy"
                   asp-action="Index">
                    <i class="bi bi-arrow-left"></i>
                    Back to my trips
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/share-link.js" asp-append-version="true"></script>
    <script src="~/js/weather.js" asp-append-version="true"></script>
}
