@model ReviewFormModel
@{
    int destinationId = (int)ViewData["DestinationId"]!;
}


<form asp-controller="Reviews"
      asp-action="Create"
      asp-area=""
      asp-route-destinationId="@destinationId"
      method="post"
      class="review-form">

    <div class="mb-3">
        <label asp-for="Rating" class="form-label">Rating</label>

        <div class="review-stars" role="radiogroup" aria-label="Choose a rating">
            @for (int rating = ValidationConstants.ReviewRatingMin;
                  rating <= ValidationConstants.ReviewRatingMax;
                  rating++)
            {
                <input type="radio"
                       name="Rating"
                       id="review-rating-@rating"
                       value="@rating"
                       class="review-star-input"
                       required />

                <label for="review-rating-@rating"
                       class="review-star-label"
                       title="@rating / @ValidationConstants.ReviewRatingMax"
                       aria-label="@rating out of @ValidationConstants.ReviewRatingMax">
                    ★
                </label>
            }
        </div>

        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Comment" class="form-label">Your review</label>
        <textarea asp-for="Comment"
                  class="form-control"
                  rows="4"></textarea>
        <span asp-validation-for="Comment" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-accent">
        <i class="bi bi-send"></i> Publish review
    </button>
</form>
