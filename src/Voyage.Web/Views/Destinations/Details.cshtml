@model Voyage.Web.ViewModels.Destinations.DestinationDetailsViewModel
@using System.Globalization

@{
    ViewData["Title"] = Model.Name;
}

@section Styles {
    @if (Model.HasCoordinates)
    {
        <link rel="stylesheet"
              href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
              integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
              crossorigin="" />
    }
}

<div class="v-cover">
    <img src="@Model.ImageUrl"
         alt="@Model.Name"
         onerror="this.style.display='none'" />

    <div class="v-cover-overlay">
        <div>
            <span class="v-badge">
                <i class="bi bi-tag"></i>
                @Model.CategoryName
            </span>
        </div>

        <h1>@Model.Name</h1>

        <div>
            <i class="bi bi-geo-alt"></i>
            @Model.Country
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8 d-flex flex-column">
        <div class="v-panel flex-grow-1">
            <h2 class="v-panel-title">About this destination</h2>
            <div class="v-destination-description">
                @foreach (var paragraph in Model.DescriptionParagraphs)
                {
                    <p>@paragraph</p>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4 v-details-side">
        <div class="v-panel">
            <h2 class="v-panel-title">Actions</h2>

            <div class="v-actions">
                <partial name="_FavoriteButton"
                         model="new FavoriteButtonViewModel
                         {
                             DestinationId = Model.Id,
                             DestinationName = Model.Name,
                             IsFavorite = Model.IsFavorite
                         }" />

<p class="favorite-count"
                   data-favorite-count-for="@Model.Id">
                    @FavoriteTexts.SavedBy(Model.FavoritesCount)
                </p>

                <a class="btn btn-accent"
                   asp-controller="Trips"
                   asp-action="Create"
                   asp-route-destinationId="@Model.Id">
                    <i class="bi bi-suitcase2"></i> Plan a trip here
                </a>

                @if (User.IsInRole(RoleConstants.Administrator))
                {
                    <a class="btn btn-navy"
                       asp-area="Admin"
                       asp-controller="Destinations"
                       asp-action="Edit"
                       asp-route-id="@Model.Id">
                        <i class="bi bi-pencil"></i> Edit
                    </a>

                    <a class="btn btn-outline-danger"
                       asp-area="Admin"
                       asp-controller="Destinations"
                       asp-action="Delete"
                       asp-route-id="@Model.Id">
                        <i class="bi bi-trash"></i> Delete
                    </a>
                }

                <a class="btn btn-outline-navy"
                   asp-action="Index">
                    <i class="bi bi-arrow-left"></i>
                    Back to destinations
                </a>
            </div>
        </div>

        <div class="v-weather-slot"
             data-weather-target="now"
             data-weather-url="@Url.Action("Weather", new { id = Model.Id })">
            <div class="v-panel">
                <p class="v-muted mb-0">
                    <i class="bi bi-cloud-sun"></i> Loading the weather...
                </p>
            </div>
        </div>
    </div>
</div>

<div data-weather-target="forecast">
    <div class="v-panel">
        <p class="v-muted mb-0">
            <i class="bi bi-calendar3"></i> Loading the forecast...
        </p>
    </div>
</div>

@if (Model.HasCoordinates)
{
    string latitude = Model.Latitude!.Value.ToString(CultureInfo.InvariantCulture);
    string longitude = Model.Longitude!.Value.ToString(CultureInfo.InvariantCulture);

    <div class="v-panel v-map-panel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="v-panel-title mb-0">On the map</h2>

            <a class="v-map-external"
               href="https://www.openstreetmap.org/?mlat=@latitude&amp;mlon=@longitude#map=12/@latitude/@longitude"
               target="_blank"
               rel="noopener">
                <i class="bi bi-box-arrow-up-right"></i> Open in OpenStreetMap
            </a>
        </div>

        <div class="v-map"
             data-map
             data-lat="@latitude"
             data-lng="@longitude"
             data-name="@Model.Name"
             role="region"
             aria-label="Map of @Model.Name">
        </div>
    </div>
}

@if (Model.SimilarDestinations.Any())
{
    <section class="v-section">
        <div class="v-section-head d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div>
                <h2 class="v-section-title">More in @Model.CategoryName</h2>
                <p class="v-muted mb-0">Other places you might like.</p>
            </div>

            <a class="btn btn-outline-navy"
               asp-action="Index"
               asp-route-categoryId="@Model.CategoryId">
                View all
            </a>
        </div>

        <div class="row g-4">
            @foreach (var destination in Model.SimilarDestinations)
            {
                <div class="col-md-4">
                    <partial name="_DestinationCard" model="destination" />
                </div>
            }
        </div>
    </section>
}

@if (Model.ExpertTips.Any() || Model.CanAddExpertTip)
{
    <partial name="_ExpertTips" model="Model" />
}

<section id="reviews" class="v-section reviews-section">
    <div class="reviews-heading">
        <h2 class="v-section-title">Reviews</h2>

        @if (Model.RatingSummary.Count > 0)
        {
            <span class="rating-summary">
                <partial name="_RatingStars" model="Model.RatingSummary.Average" />
                <span class="rating-value">@Model.RatingSummary.Average.ToString("0.0")</span>
                <small class="text-muted">(@Model.RatingSummary.Count)</small>
            </span>
        }
    </div>

    @if (Model.CanReview)
    {
        <partial name="_ReviewForm"
                 model="Model.ReviewForm"
                 view-data='new ViewDataDictionary(ViewData) { { "DestinationId", Model.Id } }' />
    }
    else if (User.Identity?.IsAuthenticated != true)
    {
        <p class="text-muted">
            <a asp-area="Identity"
               asp-page="/Account/Login"
               asp-route-returnUrl="@($"{Context.Request.Path}#reviews")">
                Log in
            </a>
            to write a review.
        </p>
    }

    <partial name="_ReviewList" model="Model.Reviews" />
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/review-form.js" asp-append-version="true"></script>
    <script src="~/js/weather.js" asp-append-version="true"></script>

    @if (Model.HasCoordinates)
    {
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
                integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
                crossorigin=""></script>
        <script src="~/js/destination-map.js" asp-append-version="true"></script>
    }
}