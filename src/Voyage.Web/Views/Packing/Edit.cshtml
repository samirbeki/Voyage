@model Voyage.Web.ViewModels.Packing.PackingItemEditViewModel

@{
    ViewData["Title"] = "Edit Packing Item";
}

<div class="mb-4">
    <div class="v-muted small mb-2">
        <a asp-controller="Trips" asp-action="Index">My Trips</a>
        <i class="bi bi-chevron-right mx-1"></i>
        <a asp-controller="Trips"
           asp-action="Details"
           asp-route-id="@Model.TripId">
            @Model.TripName
        </a>
        <i class="bi bi-chevron-right mx-1"></i>
        <a asp-controller="Packing"
           asp-action="Index"
           asp-route-tripId="@Model.TripId">
            Packing List
        </a>
        <i class="bi bi-chevron-right mx-1"></i>
        Edit Item
    </div>

    <h1 class="v-page-title">Edit packing item</h1>
    <p class="v-page-subtitle">
        Update the details of an item in your packing list.
    </p>
</div>

<div class="v-panel v-panel-narrow">
    <form asp-controller="Packing"
          asp-action="Edit"
          asp-route-id="@Model.Id"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Item name</label>
            <input asp-for="Name"
                   class="form-control"
                   placeholder="e.g. Passport, T-shirt..." />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Quantity" class="form-label">Quantity</label>
                <input asp-for="Quantity"
                       class="form-control"
                       type="number"
                       min="@PackingItemValidationConstants.QuantityMin"
                       max="@PackingItemValidationConstants.QuantityMax" />
                <span asp-validation-for="Quantity"
                      class="text-danger"></span>
            </div>

            <div class="col-md-8">
                <label asp-for="Category" class="form-label">Category</label>
                <select asp-for="Category"
                        class="form-select"
                        asp-items="Html.GetEnumSelectList<PackingCategory>()">
                </select>
                <span asp-validation-for="Category"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-accent">
                <i class="bi bi-check-lg"></i>
                Save changes
            </button>

            <a asp-controller="Packing"
               asp-action="Index"
               asp-route-tripId="@Model.TripId"
               class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}